# Copy these values into the server environment. Never put a live key in git.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://kittyapi.xyz/v1
OPENAI_MODEL=gpt-5.4
SCORING_PROVIDER=llm
# External provider calls are disabled unless explicitly enabled.
ALLOW_EXTERNAL_SCORING=false
# Required for historical-data research endpoints and the expert review UI.
RESEARCH_ACCESS_TOKEN=replace-with-a-long-local-token
# Comma-separated browser origins allowed to call the API. Same-origin
# production traffic does not need an entry, but keep local development here.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Authentication. Keep the allowlist private and comma-separated.
ADMIN_EMAILS=owner@example.com
RESEND_API_KEY=
AUTH_FROM_EMAIL=auth@qiuzheng.xyz
AUTH_APP_URL=https://qiuzheng.xyz
# Set to true only when served over HTTPS.
AUTH_COOKIE_SECURE=true
